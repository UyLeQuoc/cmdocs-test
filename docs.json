{
  "$schema": "https://cmdocs.dev/schema/docs.json",
  "name": "cmdocs",
  "description": "Self-hosted documentation platform powered by Fumadocs",
  "favicon": "/public/favicon.svg",
  "seo": {
    "title": "cmdocs Documentation",
    "titleTemplate": "%s — cmdocs",
    "description": "Build beautiful, self-hosted documentation sites from MDX content with zero effort."
  },
  "theme": {
    "colors": {
      "primary": "#2563EB"
    },
    "darkMode": true,
    "breadcrumb": true,
    "lastUpdated": true
  },
  "navbar": {
    "title": "cmdocs",
    "github": "https://github.com/CommandOSSLabs/cmdocs",
    "links": [
      {
        "text": "Dashboard",
        "href": "https://cmdocs.dev",
        "icon": "LayoutDashboard",
        "active": "none",
        "external": true
      },
      {
        "type": "icon",
        "text": "Discord",
        "href": "https://discord.gg/cmdocs",
        "icon": "MessageCircle",
        "label": "Join our Discord",
        "external": true
      },
      {
        "type": "menu",
        "text": "Resources",
        "icon": "MoreHorizontal",
        "items": [
          {
            "text": "Changelog",
            "href": "https://cmdocs.dev/changelog",
            "description": "See what's new in cmdocs"
          },
          {
            "text": "Roadmap",
            "href": "https://linear.app/commandoss",
            "description": "View our public roadmap",
            "external": true
          }
        ]
      }
    ]
  },
  "footer": {
    "text": "Built with cmdocs",
    "copyright": "© 2026 CommandOSS Labs"
  },
  "navigation": {
    "tabMode": "auto",
    "tabs": [
      {
        "tab": "Documentation",
        "description": "Learn how to build docs with cmdocs",
        "icon": "BookOpen",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["index", "quickstart", "installation"]
          },
          {
            "group": "Configuration",
            "pages": [
              "configuration/docs-json",
              "configuration/theme",
              "configuration/navigation"
            ]
          },
          {
            "group": "Writing Content",
            "pages": [
              "content/mdx-basics",
              "content/components",
              "content/frontmatter",
              "content/design-system"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/getting-started",
              "guides/migration"
            ]
          },
          {
            "group": "Advanced",
            "pages": [
              "advanced/custom-components",
              "advanced/search",
              "advanced/i18n"
            ]
          }
        ]
      },
      {
        "tab": "Deployment",
        "description": "Deploy your documentation site",
        "icon": "Rocket",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "deployment/overview",
              "deployment/github"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "deployment/custom-domains",
              "deployment/environment-variables",
              "deployment/self-hosted"
            ]
          },
          {
            "group": "Troubleshooting",
            "pages": [
              "deployment/troubleshooting/build-errors",
              "deployment/troubleshooting/dns-issues"
            ]
          }
        ]
      }
    ]
  }
}
